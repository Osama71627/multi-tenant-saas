{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["backend/manage.py", "runserver", "8000"],
      "port": 8000
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend/apps/dashboard", "dev"],
      "port": 3001
    },
    {
      "name": "storefront",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend/apps/storefront", "dev"],
      "port": 3000
    },
    {
      "name": "platform-admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend/apps/platform-admin", "dev"],
      "port": 3002
    },
    {
      "name": "dashboard-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend/apps/dashboard", "exec", "next", "start", "-p", "4001"],
      "port": 4001
    },
    {
      "name": "storefront-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend/apps/storefront", "exec", "next", "start", "-p", "4000"],
      "port": 4000
    },
    {
      "name": "platform-admin-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend/apps/platform-admin", "exec", "next", "start", "-p", "4002"],
      "port": 4002
    }
  ]
}
