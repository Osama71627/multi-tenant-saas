openapi: 3.0.3
info:
  title: Multi-Tenant SaaS E-Commerce API
  version: 1.0.0
paths:
  /api/v1/auth/email/verify/confirm:
    post:
      operationId: api_v1_auth_email_verify_confirm_create
      tags:
      - api
      security:
      - platformJwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/email/verify/resend:
    post:
      operationId: api_v1_auth_email_verify_resend_create
      tags:
      - api
      security:
      - platformJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/login:
    post:
      operationId: api_v1_auth_login_create
      description: |-
        Wraps SimpleJWT's TokenObtainPairView with the brute-force lockout
        from apps.accounts.lockout -- locked on (email, IP), see that
        module's docstring for why.

        Phase 17: a platform-staff account (`is_platform_staff=True`) never
        gets a JWT from this endpoint directly -- see `_platform_staff_login`
        below and `apps.accounts.mfa_services`' module docstring for the full
        two-step design. Ordinary accounts are completely unaffected and keep
        the exact single-step flow this view always had.
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PlatformTokenObtainPairRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PlatformTokenObtainPairRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PlatformTokenObtainPairRequest'
        required: true
      security:
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/logout:
    post:
      operationId: api_v1_auth_logout_create
      tags:
      - api
      security:
      - platformJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/me:
    get:
      operationId: api_v1_auth_me_retrieve
      tags:
      - api
      security:
      - platformJwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/mfa/enroll/confirm:
    post:
      operationId: api_v1_auth_mfa_enroll_confirm_create
      description: |-
        Second step of enrollment: {challenge_token, code} -> confirms the
        pending device, issues one-time recovery codes (returned RAW here,
        exactly once), and completes login with a full JWT (mfa=True).
      tags:
      - api
      security:
      - platformJwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/mfa/enroll/start:
    post:
      operationId: api_v1_auth_mfa_enroll_start_create
      description: |-
        First step of enrollment (only reachable with a valid challenge from
        a login that returned `state: mfa_setup_required`): generates a
        pending TOTP secret and returns it for manual entry into an
        authenticator app, plus the equivalent `otpauth://` URI.
      tags:
      - api
      security:
      - platformJwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/mfa/verify:
    post:
      operationId: api_v1_auth_mfa_verify_create
      description: |-
        Second step of platform-staff login for an already-enrolled device:
        {challenge_token, code} -> full JWT (mfa=True). `code` may be a 6-digit
        TOTP code or a recovery code (see `_looks_like_recovery_code`).
      tags:
      - api
      security:
      - platformJwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/password/reset:
    post:
      operationId: api_v1_auth_password_reset_create
      tags:
      - api
      security:
      - platformJwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/password/reset/confirm:
    post:
      operationId: api_v1_auth_password_reset_confirm_create
      tags:
      - api
      security:
      - platformJwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/refresh:
    post:
      operationId: api_v1_auth_refresh_create
      description: |-
        Takes a refresh type JSON web token and returns an access type JSON web
        token if the refresh token is valid.
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PlatformTokenRefreshRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PlatformTokenRefreshRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PlatformTokenRefreshRequest'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PlatformTokenRefresh'
          description: ''
  /api/v1/auth/register:
    post:
      operationId: api_v1_auth_register_create
      tags:
      - api
      security:
      - platformJwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/dashboard/stores:
    get:
      operationId: api_v1_dashboard_stores_list
      description: |-
        `GET /api/v1/dashboard/stores` -- the store switcher's data source
        (docs/ARCHITECTURE.md section 7.3): stores the current user has an
        ACTIVE membership in; see apps.stores.services.list_stores_for_user
        for why this is a legitimate cross-tenant read. `POST` is the
        existing store-provisioning endpoint, unchanged.
      tags:
      - api
      security:
      - platformJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/StoreListItem'
          description: ''
    post:
      operationId: api_v1_dashboard_stores_create
      description: |-
        `GET /api/v1/dashboard/stores` -- the store switcher's data source
        (docs/ARCHITECTURE.md section 7.3): stores the current user has an
        ACTIVE membership in; see apps.stores.services.list_stores_for_user
        for why this is a legitimate cross-tenant read. `POST` is the
        existing store-provisioning endpoint, unchanged.
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CreateStoreRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CreateStoreRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CreateStoreRequest'
        required: true
      security:
      - platformJwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/StoreDetail'
          description: ''
  /api/v1/dashboard/stores/{store_id}:
    get:
      operationId: api_v1_dashboard_stores_retrieve
      description: '404 vs 403 semantics, and why: apps/stores/mixins.py:StoreScopedAPIView.'
      parameters:
      - in: path
        name: store_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - api
      security:
      - platformJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/StoreDetail'
          description: ''
    patch:
      operationId: api_v1_dashboard_stores_partial_update
      description: '404 vs 403 semantics, and why: apps/stores/mixins.py:StoreScopedAPIView.'
      parameters:
      - in: path
        name: store_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedUpdateStoreRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedUpdateStoreRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedUpdateStoreRequest'
      security:
      - platformJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/StoreDetail'
          description: ''
  /api/v1/dashboard/stores/{store_id}/analytics/overview:
    get:
      operationId: api_v1_dashboard_stores_analytics_overview_retrieve
      description: |-
        Base class for any `/api/v1/dashboard/stores/<uuid:store_id>/...`
        endpoint. Relies on `TenantMiddleware` having already resolved the
        path's `store_id` into `request.tenant_store` (path-based, Host
        header ignored -- apps/stores/middleware.py).

        404 vs 403 distinguished on purpose (same reasoning as Phase 3's
        StoreDetailView, docs/PHASE_3_REPORT.md): a store's existence isn't
        secret (its RLS SELECT policy is intentionally open), but catalog
        resources INSIDE it are fully RLS-restricted with no such exception
        -- so once past this gate, an ordinary tenant-scoped query for a
        resource that doesn't exist in this store naturally 404s via
        `DoesNotExist`, with no separate leak to worry about.

        Sets `self.store` for subclasses to use.
      parameters:
      - in: path
        name: store_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - api
      security:
      - platformJwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
