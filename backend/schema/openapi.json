        or validated against directly (the view returns the service's dict as-is).
      properties:
        id:
          type: string
          format: uuid
        order_id:
          type: string
          format: uuid
        state:
          type: string
        amount:
          type: integer
        currency:
          type: string
        provider_key:
          type: string
      required:
      - amount
      - currency
      - id
      - order_id
      - provider_key
      - state
    PaymentStatusEnum:
