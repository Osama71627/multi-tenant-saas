        order_id:
          type: string
          format: uuid
        provider_key:
          $ref: '#/components/schemas/ProviderKeyEnum'
      required:
      - order_id
      - provider_key
    PaymentIntentResponse:
      type: object
      description: |-
        Documents the exact plain-dict shape `apps.payments.services._intent_body`
