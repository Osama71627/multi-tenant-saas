  /api/v1/webhooks/payments/{provider}/{store_id}:
    post:
      operationId: api_v1_webhooks_payments_create
      description: |-
        Base class for `/api/v1/webhooks/payments/<provider>/<uuid:store_id>`
        (Phase 9) -- the third tenant-resolution strategy, added to
        `TenantMiddleware` alongside dashboard/storefront (see that module's
        docstring). No Host to trust, no authenticated user to check
        membership for (`AllowAny`, same reasoning as `StorefrontAPIView`) --
        the store_id path segment ONLY resolves which tenant's RLS scope to
        look the provider config up in. It is never treated as a security
        boundary by itself: `apps.payments.services.process_webhook` still
        verifies the provider's signature before any side effect, exactly as
        it would for a forged store_id pointing at a real store.

        Sets `self.store` for subclasses to use.
      parameters:
      - in: path
        name: provider
        schema:
          type: string
        required: true
      - in: path
        name: store_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - api
      security:
      - platformJwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
components:
  schemas:
    AddCartItemRequest:
      type: object
      properties:
        variant:
          type: string
          format: uuid
        quantity:
          type: integer
          minimum: 1
      required:
      - quantity
      - variant
    AdjustStockRequest:
      type: object
      properties:
        variant:
          type: string
          format: uuid
        location:
          type: string
          format: uuid
        delta:
          type: integer
        reason:
          type: string
          minLength: 1
          maxLength: 255
        reference:
          type: string
          default: ''
          maxLength: 255
      required:
      - delta
      - location
      - reason
      - variant
    ApplyCouponRequest:
      type: object
      properties:
        code:
          type: string
          minLength: 1
          maxLength: 64
      required:
      - code
    AuditLog:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        actor_user_id:
          type: string
          format: uuid
          readOnly: true
        actor_email:
          type: string
          format: email
          readOnly: true
          description: Denormalized at write time -- readable without a second cross-role
            join, and stable even if the actor account is later renamed.
        action:
          type: string
          readOnly: true
        target_type:
          type: string
          readOnly: true
        target_id:
          type: string
          format: uuid
          readOnly: true
        store_id:
          type: string
          format: uuid
          readOnly: true
          nullable: true
        metadata:
          readOnly: true
          description: Safe, non-secret context only -- never tokens/passwords/payment
            data.
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - action
      - actor_email
      - actor_user_id
      - created_at
      - id
      - metadata
      - store_id
      - target_id
      - target_type
    BillingIntervalEnum:
      enum:
      - monthly
      - yearly
      type: string
      description: |-
        * `monthly` - Monthly
        * `yearly` - Yearly
    BusinessInfoRequest:
      type: object
      description: |-
        Phase F. Multipart (the request carries a real file for `logo`).
        `contact_email` is deliberately NOT a field here -- it is always the
        authenticated user's own account email, taken server-side in the
        view, never accepted from the client (see
        apps.subscriptions.services.complete_checkout_with_business_info's
        docstring).
      properties:
        store_name:
          type: string
          minLength: 1
          maxLength: 255
        business_category:
          type: string
          minLength: 1
          maxLength: 100
        contact_phone:
          type: string
          minLength: 1
          maxLength: 32
        logo:
          type: string
          format: binary
          nullable: true
      required:
      - business_category
      - contact_phone
      - store_name
    Cart:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        status:
          allOf:
          - $ref: '#/components/schemas/CartStatusEnum'
          readOnly: true
        currency:
          type: string
          readOnly: true
        items:
          type: array
          items:
            $ref: '#/components/schemas/CartItem'
          readOnly: true
        coupon_code:
          type: string
          readOnly: true
        subtotal_amount:
          type: integer
          readOnly: true
        discount_amount:
          type: integer
          readOnly: true
        tax_amount:
          type: integer
          readOnly: true
        total_amount:
          type: integer
          readOnly: true
      required:
      - coupon_code
      - currency
      - discount_amount
      - id
      - items
      - status
      - subtotal_amount
      - tax_amount
      - total_amount
    CartItem:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        variant:
          type: string
          format: uuid
        variant_sku:
          type: string
          readOnly: true
        quantity:
          type: integer
          maximum: 2147483647
          minimum: 0
        unit_price_amount:
          type: integer
          readOnly: true
        currency:
          type: string
          readOnly: true
      required:
      - currency
      - id
      - quantity
      - unit_price_amount
      - variant
      - variant_sku
    CartStatusEnum:
      enum:
      - active
      - abandoned
      type: string
      description: |-
        * `active` - Active
        * `abandoned` - Abandoned
    CheckoutAddressRequestRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          minLength: 1
        shipping_address:
          $ref: '#/components/schemas/ShippingAddressRequest'
      required:
      - email
      - shipping_address
    CheckoutSession:
      type: object
      properties:
        id:
          type: string
          format: uuid
        status:
          type: string
        expires_at:
          type: string
          format: date-time
        email:
          type: string
          format: email
        shipping_address:
          nullable: true
        shipping_method_id:
          type: string
          format: uuid
          nullable: true
        shipping_method_name_snapshot:
          type: string
        shipping_amount_snapshot:
          type: integer
          nullable: true
      required:
      - email
      - expires_at
      - id
      - shipping_address
      - shipping_amount_snapshot
      - shipping_method_id
      - shipping_method_name_snapshot
      - status
    CheckoutShippingRequestRequest:
      type: object
      properties:
        shipping_method_id:
          type: string
          format: uuid
      required:
      - shipping_method_id
    CheckoutStatusEnum:
      enum:
      - draft
      - ready_for_payment
      - payment_pending
      - payment_failed
      - awaiting_business_info
      - completed
      - abandoned
      - expired
      type: string
      description: |-
        * `draft` - Draft
        * `ready_for_payment` - Ready for payment
        * `payment_pending` - Payment pending
        * `payment_failed` - Payment failed
        * `awaiting_business_info` - Awaiting business info
        * `completed` - Completed
        * `abandoned` - Abandoned
        * `expired` - Expired
    CreateProductRequest:
      type: object
      description: 'One-shot: Product + its default variant -- see apps/catalog/services.py:create_product.'
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 255
        slug:
          type: string
          minLength: 1
          maxLength: 255
          pattern: ^[-a-zA-Z0-9_]+$
        description:
          type: string
          default: ''
        seo_title:
          type: string
          default: ''
        seo_description:
          type: string
          default: ''
        sku:
          type: string
          minLength: 1
          maxLength: 64
        price_amount:
          type: integer
          minimum: 0
        currency:
          type: string
          minLength: 1
          maxLength: 3
      required:
      - name
      - price_amount
      - sku
      - slug
    CreateStoreRequest:
      type: object
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 255
        slug:
          type: string
          minLength: 1
          maxLength: 63
          pattern: ^[-a-zA-Z0-9_]+$
        theme_preset_id:
          type: string
          format: uuid
          nullable: true
      required:
      - name
      - slug
    CreatedStore:
      type: object
      description: |-
        Minimal response for the business-info step -- just enough for
        the frontend to redirect straight to the new Store's dashboard.
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          readOnly: true
        slug:
          type: string
          readOnly: true
          pattern: ^[-a-zA-Z0-9_]+$
      required:
      - id
      - name
      - slug
    FulfillmentStatusEnum:
      enum:
      - unfulfilled
      type: string
      description: '* `unfulfilled` - Unfulfilled'
    InitiatePaymentRequest:
      type: object
      description: |-
        Phase E. `card_number` is NEVER persisted (see
        `SubscriptionPaymentIntent` -- no card-data field exists on it at
        all) -- used only by `apps.subscriptions.billing.simulate_demo_outcome`
        to pick which demo outcome fires. Not validated as a real card
        number (Luhn, length, etc.) on purpose -- this is a sandbox
        convention (Stripe-test-number-style), not a real payment field.
      properties:
        card_number:
          type: string
          minLength: 4
          maxLength: 32
      required:
      - card_number
    KindEnum:
      enum:
      - flat
      - free
      - weight_based
      - price_based
      - carrier_calculated
      type: string
      description: |-
        * `flat` - Flat rate
        * `free` - Free shipping
        * `weight_based` - Weight based
        * `price_based` - Order value based
        * `carrier_calculated` - Carrier calculated
    ModeEnum:
      enum:
      - test
      - live
      type: string
      description: |-
        * `test` - Test
        * `live` - Live
    Order:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        number:
          type: string
          maxLength: 32
        email:
          type: string
          format: email
          maxLength: 254
        status:
          $ref: '#/components/schemas/Status206Enum'
        fulfillment_status:
          $ref: '#/components/schemas/FulfillmentStatusEnum'
        currency:
          type: string
          maxLength: 3
        subtotal_amount:
          type: integer
          maximum: 2147483647
          minimum: 0
        discount_amount:
          type: integer
          maximum: 2147483647
          minimum: 0
        tax_amount:
          type: integer
          maximum: 2147483647
          minimum: 0
        shipping_amount:
          type: integer
          maximum: 2147483647
          minimum: 0
        total_amount:
          type: integer
          maximum: 2147483647
          minimum: 0
        shipping_address: {}
        shipping_method_name_snapshot:
          type: string
          maxLength: 255
        coupon_code_snapshot:
          type: string
          maxLength: 64
        created_at:
          type: string
          format: date-time
          readOnly: true
        items:
          type: array
          items:
            $ref: '#/components/schemas/OrderItem'
          readOnly: true
      required:
      - created_at
      - currency
      - discount_amount
      - email
      - id
      - items
      - number
      - shipping_address
      - shipping_amount
      - shipping_method_name_snapshot
      - subtotal_amount
      - tax_amount
      - total_amount
    OrderItem:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        variant_name_snapshot:
          type: string
          maxLength: 255
        variant_sku_snapshot:
          type: string
          maxLength: 64
        variant_options_snapshot: {}
        unit_price_amount:
          type: integer
          maximum: 2147483647
          minimum: 0
        quantity:
          type: integer
          maximum: 2147483647
          minimum: 0
        currency:
          type: string
          maxLength: 3
        line_total_amount:
          type: integer
          readOnly: true
      required:
      - currency
      - id
      - line_total_amount
      - quantity
      - unit_price_amount
      - variant_name_snapshot
      - variant_sku_snapshot
    OrderList:
      type: object
      description: Dashboard list view -- no `items` (avoids N+1 across a page of
        orders).
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        number:
          type: string
          maxLength: 32
        email:
          type: string
          format: email
          maxLength: 254
        status:
          $ref: '#/components/schemas/Status206Enum'
        fulfillment_status:
          $ref: '#/components/schemas/FulfillmentStatusEnum'
        currency:
          type: string
          maxLength: 3
        total_amount:
          type: integer
          maximum: 2147483647
          minimum: 0
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - currency
      - email
      - id
      - number
      - total_amount
    PatchedSelectPlanRequest:
      type: object
      properties:
        plan_version_id:
          type: string
          format: uuid
    PatchedUpdateCartItemRequest:
      type: object
      properties:
        quantity:
          type: integer
          minimum: 0
    PatchedUpdateProductRequest:
      type: object
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 255
        slug:
          type: string
          minLength: 1
          maxLength: 255
          pattern: ^[-a-zA-Z0-9_]+$
        description:
          type: string
        status:
          $ref: '#/components/schemas/StatusA5eEnum'
        seo_title:
          type: string
          maxLength: 255
        seo_description:
          type: string
          maxLength: 500
    PatchedUpdateStoreRequest:
      type: object
      description: |-
        PATCH surface for store settings (Phase 12). Deliberately narrow:
        only fields Store itself already authoritatively owns --
        `status` is excluded (subscription-lifecycle-managed, see
        apps.subscriptions.tasks, never merchant-settable directly), and
        nothing here touches StoreDomain/StoreThemeConfig, which have their
        own owners.
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 255
        slug:
          type: string
          minLength: 1
          maxLength: 63
          pattern: ^[-a-zA-Z0-9_]+$
        default_currency:
          type: string
          minLength: 1
          maxLength: 3
        contact_email:
          type: string
          format: email
          maxLength: 254
        contact_phone:
          type: string
          maxLength: 32
    PaymentInitiateRequestRequest:
      type: object
