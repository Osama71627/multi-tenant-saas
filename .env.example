# Copy to .env for local development. NEVER commit a real .env.
# In production these come from your secret manager / orchestrator, not a file.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Three DB roles -- see docs/ARCHITECTURE.md section 2.3. `app_user` runs the
# application and CANNOT bypass Row-Level Security. `app_migrator` owns the
# schema and is used ONLY for `manage.py migrate --database=migrator`.
# `app_platform_admin` (Phase 14) is BYPASSRLS but holds only narrow,
# explicit GRANTs on the specific tables apps.platform_admin needs -- see
# apps/platform_admin/apps.py. Used ONLY by apps.platform_admin, never by
# any other app.
# Port 5432 assumes the docker-compose Postgres (see docker-compose.yml).
# If you're running Postgres locally instead (e.g. via WSL) and already
# have something else bound to 5432, adjust the port here accordingly.
DATABASE_URL=postgres://app_user:devpass_appuser@127.0.0.1:5432/saas_dev
MIGRATOR_DATABASE_URL=postgres://app_migrator:devpass_migrator@127.0.0.1:5432/saas_dev
PLATFORM_DATABASE_URL=postgres://app_platform_admin:devpass_platformadmin@127.0.0.1:5432/saas_dev

REDIS_URL=redis://127.0.0.1:6379/0

# --- production-only (no defaults in code -- startup fails without these) ---
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# SENTRY_DSN=
# CORS_ALLOWED_ORIGINS=
