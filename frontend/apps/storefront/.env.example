# Server-only -- Next's RSC/server-side fetches to Django go through
# this internal address, with X-Forwarded-Host set to the real shopper
# hostname (see lib/backend.ts). Never exposed to the browser.
BACKEND_INTERNAL_URL=http://localhost:8000

# Public -- the browser needs this to call Django directly (no BFF here,
# see lib/backend.ts's docstring for why). Same value as Django's own
# dev port; only the hostname differs per store.
NEXT_PUBLIC_BACKEND_PORT=8000
