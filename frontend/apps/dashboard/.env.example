# Server-only -- never exposed to the browser (no NEXT_PUBLIC_ prefix).
# The BFF (app/api/bff/*) is the only thing that ever calls this; the
# browser only ever talks to /api/bff/* on the dashboard's own origin.
BACKEND_INTERNAL_URL=http://localhost:8000

# Public -- "Preview store" opens the merchant's real storefront (a
# different origin/port than the dashboard itself) in a new tab. Same
# convention as NEXT_PUBLIC_BACKEND_PORT in apps/storefront/.env* --
# only this port differs between the storefront's `next dev` (3000) and
# this `next start` preview (4000); only the hostname differs per store.
NEXT_PUBLIC_STOREFRONT_PORT=4000
