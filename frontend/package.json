{
  "name": "multi-tenant-saas-frontend",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:dashboard": "turbo run dev --filter=@saas/dashboard",
    "dev:storefront": "turbo run dev --filter=@saas/storefront",
    "dev:platform-admin": "turbo run dev --filter=@saas/platform-admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "generate:api": "node packages/api-client/scripts/generate.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
